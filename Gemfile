source "https://rubygems.org"

# Usa esattamente le gem supportate da GitHub Pages:
# così il sito si builda automaticamente, senza GitHub Actions custom.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-feed"
end

# Necessario su alcuni sistemi operativi recenti
gem "webrick"
